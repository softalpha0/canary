# Copy to .env (git-ignored). Testnet only — never put mainnet keys here.

# Network (defaults shown; scripts/config.ts falls back to these)
CHAIN_ID=qorechain-diana
EVM_CHAIN_ID=9800
EVM_RPC_URL=https://evm-testnet.qore.host
RPC_URL=https://rpc-testnet.qore.host
REST_URL=https://api-testnet.qore.host
EXPLORER_URL=https://explore.qore.network

# Demo accounts (eth_secp256k1, coin type 60). Generate with: pnpm accounts create
DEPLOYER_MNEMONIC=
LP1_MNEMONIC=
BUYER1_MNEMONIC=
REPORTER_MNEMONIC=

# Test canary key (plain secp256k1). Generate with: pnpm canary:gen-test (M2)
TEST_CANARY_PRIVATE_KEY=
